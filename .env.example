# Public frontend configuration; leave empty for same-origin /api.
# Never put provider keys or proxy secrets in VITE_ variables.
VITE_ASSISTANT_API_URL=
VITE_PWA=true

# Local development API. The Vite dev server proxies /api to this port.
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,capacitor://localhost,ionic://localhost
TRUST_PROXY=0

# disabled | mock | openai | agicto. Mock never calls a paid provider.
ASSISTANT_MODE=mock
AI_TIMEOUT_MS=20000
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
ASSISTANT_GLOBAL_RATE_LIMIT_PER_MINUTE=60
ASSISTANT_DAILY_REQUEST_LIMIT=1000
ASSISTANT_MAX_CONCURRENT=4
ASSISTANT_MAX_RATE_LIMIT_KEYS=10000

# Only for a deployment with an authenticating, quota-enforcing gateway.
# See docs/Docker.md. Setting a key alone does not enable online AI.
ASSISTANT_ACCESS_MODE=
ASSISTANT_PROXY_SECRET=

# ASSISTANT_MODE=openai
AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# ASSISTANT_MODE=agicto
AGICTO_MODEL=gpt-6-luna
AGICTO_API_KEY=
