{
  "name": "hanyu-cards",
  "version": "1.0.0",
  "description": "Offline-first HSK 1-3 Mandarin learning app with an AI tutor assistant.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "cross-env NODE_ENV=test vite build --outDir dist-test",
    "preview": "vite preview",
    "preview:test": "vite preview --outDir dist-test",
    "types": "vue-tsc --noEmit",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:fix": "eslint --fix --ext .js,.ts,.vue src",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
    "prepare": "node .husky/install.mjs",
    "test": "vitest",
    "test:ci": "vitest --run",
    "cypress:open": "cypress open --config-file cypress/configs/index.ts",
    "cypress:open:update-snapshots": "npm run cypress:open -- -e type=base",
    "cypress:open:preview": "cypress open --config-file cypress/configs/preview.ts",
    "cypress:open:mobile:preview": "cypress open --config-file cypress/configs/mobile.preview.ts",
    "cypress:open:mobile": "cypress open --config-file cypress/configs/mobile.ts",
    "cypress:run": "cypress run --config-file cypress/configs/index.ts",
    "cypress:run:preview": "cypress run --config-file cypress/configs/preview.ts",
    "cypress:run:mobile": "cypress run --config-file cypress/configs/mobile.ts",
    "cypress:run:mobile:preview": "cypress run --config-file cypress/configs/mobile.preview.ts",
    "cypress:run:update-snapshots": "npm run cypress:run:update-snapshots:desktop && npm run cypress:run:update-snapshots:mobile",
    "cypress:run:update-snapshots:desktop": "npm run cypress:run -- -e type=base",
    "cypress:run:update-snapshots:mobile": "npm run cypress:run:mobile -- -e type=base",
    "test:server": "node --test tests/server/*.test.mjs",
    "check": "npm run types && npm run lint && npm run stylelint && npm run test:ci && npm run test:server && npm run build",
    "mobile:build": "npm run types && vite build --mode mobile",
    "mobile:doctor": "node scripts/verify-mobile-config.mjs",
    "mobile:android:debug": "npm run mobile:build && cap sync android && cd android && ./gradlew assembleDebug",
    "mobile:android:release": "node scripts/verify-mobile-config.mjs --android-release && npm run mobile:build && cap sync android && cd android && ./gradlew bundleRelease",
    "mobile:ios:sync": "npm run mobile:build && cap sync ios"
  },
  "lint-staged": {
    "src/**/*.{scss,vue}": [
      "stylelint --fix",
      "git add"
    ],
    "src/*.{js,ts,vue}": [
      "eslint --fix",
      "git add"
    ],
    "cypress/*.{js,ts}": [
      "eslint --fix",
      "git add"
    ],
    "tests/*.{js,ts}": [
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.3",
    "@vicons/ionicons5": "^0.12.0",
    "cors": "^2.8.5",
    "dayjs": "^1.10.7",
    "dotenv": "^16.4.4",
    "express": "^4.21.2",
    "localforage": "^1.10.0",
    "openai": "^7.63.0",
    "pinia": "^2.0.6",
    "vue": "^3.5.46",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@pinia/testing": "^0.1.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "cypress": "^15.18.1",
    "cypress-visual-regression": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-import-newlines": "^1.3.0",
    "eslint-plugin-vue": "^9.8.0",
    "fake-indexeddb": "^5.0.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.1",
    "lodash.debounce": "^4.0.8",
    "postcss": "^8.4.5",
    "postcss-html": "^1.3.0",
    "sass": "^1.45.0",
    "stylelint": "^14.2.0",
    "stylelint-config-recommended-scss": "^8.0.0",
    "stylelint-order": "^6.0.1",
    "stylelint-scss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.14",
    "workbox-precaching": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
