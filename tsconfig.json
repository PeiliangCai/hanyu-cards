{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom", "WebWorker"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./*"]
    },
    "types": [
      "vitest/importMeta",
      "vite-plugin-pwa/client",
    ]
  },
  "include": [
    "src/**/*.vue",
    "src/**/*.ts",
    "src/**/*.cy.ts",
    "src/**/*.d.ts",
    "types/**/*.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts",
  ],
  "exclude": [
    "src/components/InterfaceLanguageSelector/**",
    "src/composables/useAppBreakpoints.ts",
    "src/composables/useItemsSelection.ts",
    "src/composables/useLearningLanguage.ts",
    "src/composables/useRequestMethod.ts",
    "src/composables/useVirtualScrollListItemEmits.ts",
    "src/composables/useVoiceover.ts",
    "src/hooks/**",
    "src/modules/**",
    "src/plugins/errorHandler.ts",
    "src/plugins/firebase.ts",
    "src/plugins/__mocks__/**",
    "src/plugins/i18n.ts",
    "src/plugins/services.ts",
    "src/router/guard/**",
    "src/services/**",
    "src/store/modules/**"
  ]
}
